# Regra da casa: texto sai do checkout em CRLF, sempre.
* text=auto eol=crlf

# ---- Texto do projeto, explicito (nao depender do palpite do git) ----
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.txt   text eol=crlf
*.iss   text eol=crlf
*.md    text eol=crlf
.gitignore      text eol=crlf
.gitattributes  text eol=crlf

# ---- Binario: o git nao encosta ----
*.exe   binary
*.dll   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.gz    binary
*.db    binary
*.zip   binary
*.7z    binary
*.rar   binary
